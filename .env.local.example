# From Supabase: Project Settings -> API
# These are used directly in the browser (client-side), so only ever put
# the publishable/anon key here — never a secret/service_role key. Row
# Level Security policies in sql/schema.sql control what this key can do.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
